# Never commit ROMs or saves - supply your own legally-dumped copy.
*.gba
*.gbc
*.gb
*.agb
*.sav
*.srm
*.sa1
# ...nor them zipped, as patches, savestates (they hold the save too) or the app's per-state files.
*.zip
*.7z
*.rar
*.ips
*.ups
*.bps
*.ss
*.ss[0-9]
*.state*
*.ra
# Built apps and rendered audio (FF music clips / clicks are rendered from the player's ROM).
*.apk
*.aab
*.wav

# Machine-local config
local.properties
local.mk
# Release signing (see app/build.gradle.kts) - never commit the key or its passwords.
keystore.properties
*.jks
*.keystore
*.pem
*.p12
.env
google-services.json

# Gradle / Android build outputs
.gradle/
build/
.cxx/
.kotlin/
.idea/
*.iml

# Paparazzi screenshots - a viewing aid, re-recorded on demand (see CLAUDE.md).
/app/src/test/snapshots/

# Headless capture tool output: mgba_dump is compiled fresh inside the
# pokedaisy-capture image each run (a Linux ELF, not portable).
/native-capture/mgba_dump
/native-capture/menu-shots/

__pycache__/
.DS_Store
.claude/settings.local.json
