<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- Only requested/used when the user picks a custom game-saves folder in
         Settings > Folders > Change folder (see SettingsActivity). Save files are
         opened by raw path from native code, which scoped storage otherwise
         blocks outside this app's own sandbox. Sideloaded app, not distributed
         via Play, so the "All files access" review restriction doesn't apply. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Two uses, both outbound HTTPS only: library cover art (Settings > Cover
         Art) from SteamGridDB's API with a user-supplied key (Prefs.steamGridDbApiKey /
         SteamGridDbClient), and the update check against this app's GitHub releases
         (AppUpdater: api.github.com + GitHub's download host). Nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- In-app update: hands a downloaded release APK to Android's installer (AppUpdateFlow). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PokeDaisy">

        <activity
            android:name=".LibraryActivity"
            android:exported="true"
            android:theme="@style/Theme.PokeDaisy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.gba" />
            </intent-filter>
        </activity>

        <!-- For frontends (Cocoon, iiSU, ES-DE, ...): started explicitly with the
             ROM as the intent's data or a "rom"/"ROM" path extra, it opens the
             game directly (see LaunchActivity). No intent filter on purpose -
             explicit launches don't need one, and a VIEW filter would put a
             second PokeDaisy in every "Open with" list next to the library's.
             Its own empty affinity keeps it out of the library's task. -->
        <activity
            android:name=".LaunchActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PokeDaisy.Launch" />

        <!-- Serves a downloaded update APK (cache/updates/) to the package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.PokeDaisy" />

        <activity
            android:name=".PokeDaisyActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|navigation|uiMode"
            android:launchMode="singleTask"
            android:parentActivityName=".LibraryActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.PokeDaisy" />
    </application>
</manifest>
