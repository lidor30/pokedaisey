---
// Feedback without a GitHub account: a game request, a bug report or a feature idea, written straight to
// Firestore (write-only, firestore.rules) and turned into a GitHub issue by functions/index.js. The fields
// and checks come from functions/feedback-form.js, shared with that function and mirroring the issue
// templates. The ROM check links here with its readings in the URL's #hash (never sent to the server).
import Base from '../layouts/Base.astro';
import Pixel from '../components/Pixel.astro';
import { FORMS, DEVICES, CONTACT_MAX } from '../../functions/feedback-form.js';
import { REPO_URL } from '../lib/releases.js';

const kinds = [
  ['game', 'REQUEST A GAME', 'logo', 0.334, 'rom_request.yml'],
  ['bug', 'REPORT A BUG', 'bug', 0.667, 'bug_report.yml'],
  ['feature', 'SUGGEST A FEATURE', 'guide', 0.5, 'feature_request.yml'],
] as const;
---
<Base
  title="Feedback · PokeDaisy"
  description="Request a game, report a bug or suggest a feature for PokeDaisy - no GitHub account needed."
>
  <section class="block container narrow">
    <div class="section-head">
      <span class="eyebrow">FEEDBACK</span>
      <h1 class="heading">Tell PokeDaisy what you need</h1>
      <p class="lead">Ask for a game, report a bug or share an idea. No GitHub account needed: what you send here
        becomes an issue on <a href={`${REPO_URL}/issues`}>PokeDaisy's GitHub</a>, where anyone can follow it.</p>
    </div>

    <form class="feedback" data-feedback novalidate>
      <div class="kinds" role="radiogroup" aria-label="What are you sending?">
        {kinds.map(([kind, label, icon, scale], i) => (
          <label class="kind btn f-btn h-btnHot">
            <input type="radio" name="kind" value={kind} checked={i === 0} />
            <Pixel name={icon} scale={scale} /> {label}
          </label>
        ))}
      </div>

      <div class="f-card sheet">
        {kinds.map(([kind, , , , template]) => (
          <fieldset class="fields" data-kind={kind} hidden={kind !== 'game'}>
            <legend class="sr">{FORMS[kind].title}</legend>
            {kind === 'game' && (
              <p class="note small"><Pixel name="logo" scale={0.334} /> Support is added per exact version, found by the ROM's SHA-1.
                <a href="/compatibility/">The ROM check</a> fills these in for you.</p>
            )}
            {FORMS[kind].fields.map((f) => (
              <label class="field">
                <span class="flabel">{f.label}{f.required && <span class="req" aria-hidden="true"> *</span>}</span>
                {f.hint && <span class="fhint tiny muted">{f.hint}</span>}
                {f.type === 'textarea'
                  ? <textarea class="f-btn h-btnHot" name={f.id} maxlength={f.max} rows={f.id === 'logs' ? 6 : 4} placeholder={f.placeholder} required={f.required} />
                  : f.type === 'select'
                    ? <select class="f-btn h-btnHot" name={f.id} required={f.required}>
                        <option value="">Pick one…</option>
                        {DEVICES.map((d) => <option value={d}>{d}</option>)}
                      </select>
                    : <input class="f-btn h-btnHot" name={f.id} maxlength={f.max} placeholder={f.placeholder} required={f.required} autocomplete="off" spellcheck={f.id === 'sha1' || f.id === 'size' ? 'false' : undefined} />}
                <span class="ferr tiny" data-error={f.id}></span>
              </label>
            ))}
            <p class="tiny muted">Have a GitHub account? <a href={`${REPO_URL}/issues/new?template=${template}`}>Open it on GitHub</a> instead.</p>
          </fieldset>
        ))}

        <label class="field contact">
          <span class="flabel">How to reach you <span class="muted">(optional)</span></span>
          <span class="fhint tiny muted">An email or a Discord name, in case there's a question. Never published: only the maintainer sees it.</span>
          <input class="f-btn h-btnHot" name="contact" maxlength={CONTACT_MAX} autocomplete="email" />
          <span class="ferr tiny" data-error="contact"></span>
        </label>
        <!-- Left empty by people; filled in by form-filling bots, which then get a polite nothing. -->
        <label class="trap" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>

        <p class="warn small"><Pixel name="no" scale={0.5} /> Never attach or link a ROM - name the game and its version instead.</p>
        <div class="send">
          <button class="btn f-primary h-primaryHot primary big" type="submit" data-send>SEND</button>
          <span class="status small" data-status aria-live="polite"></span>
        </div>
      </div>
    </form>

    <div class="f-card sheet thanks" data-thanks hidden>
      <span class="thanks-art"><Pixel name="logo" scale={2} /></span>
      <h2 class="heading">Thanks!</h2>
      <p class="lead">It's on its way. It shows up on <a href={`${REPO_URL}/issues`}>PokeDaisy's GitHub issues</a> in a minute or two.</p>
      <button class="btn f-btn h-btnHot small" type="button" data-again>SEND ANOTHER</button>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 900px; }
  /* The grids below would otherwise show what the script hides (the other kinds' fields, the thanks). */
  [hidden] { display: none !important; }
  .feedback { display: grid; gap: 28px; }
  .kinds { display: flex; flex-wrap: wrap; gap: 16px; }
  .kind { font-size: var(--t-s); }
  .kind input { position: absolute; opacity: 0; pointer-events: none; }
  .kind:has(input:checked) { color: #fff; text-shadow: var(--px) var(--px) 0 #8a1410; border-image-source: none; background: var(--red); outline: var(--px) solid var(--ink); }
  .kind:has(input:focus-visible) { outline: var(--px) dashed var(--red); outline-offset: calc(var(--px) * 2); }
  .sheet { filter: var(--hard-shadow); display: grid; gap: 22px; padding: calc(var(--px) * 8); }
  .fields { display: grid; gap: 22px; border: 0; margin: 0; padding: 0; min-width: 0; }
  .field { display: grid; gap: 6px; }
  .flabel { font-size: var(--t-s); text-shadow: var(--bold); letter-spacing: 0.0625em; }
  .req { color: var(--red); }
  .field input, .field textarea, .field select {
    font: inherit; font-size: var(--t-s); color: var(--ink); width: 100%;
    padding: calc(var(--px) * 1) calc(var(--px) * 2); outline: none; resize: vertical;
  }
  .field textarea { line-height: 1.4; }
  .field select { appearance: none; cursor: pointer; }
  .field ::placeholder { color: #a8a6b6; }
  .ferr { color: var(--red-ink); min-height: 0; }
  .ferr:empty { display: none; }
  .field.bad input, .field.bad textarea, .field.bad select { background: #fff1ef; }
  .note { color: var(--ink-2); }
  .note :global(.pixel) { display: inline-block; vertical-align: middle; margin-right: 8px; }
  .warn { display: flex; align-items: center; gap: 10px; color: var(--red-ink); }
  .send { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .status { color: var(--muted); }
  .status.error { color: var(--red-ink); }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .thanks { justify-items: center; text-align: center; padding: calc(var(--px) * 14) calc(var(--px) * 8); }
  .thanks .lead { margin-top: 0; max-width: 38ch; }
  @media (max-width: 760px) { .kinds { display: grid; } .sheet { padding: calc(var(--px) * 6); } }
</style>

<script>
  import { clean, validate, toFirestore } from '../../functions/feedback-form.js';

  const ENDPOINT = 'https://firestore.googleapis.com/v1/projects/pokedaisy/databases/(default)/documents/feedback';
  const form = document.querySelector<HTMLFormElement>('[data-feedback]')!;
  const thanks = document.querySelector<HTMLElement>('[data-thanks]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const send = form.querySelector<HTMLButtonElement>('[data-send]')!;

  const kind = () => form.querySelector<HTMLInputElement>('input[name=kind]:checked')!.value;
  const showKind = (k: string) => {
    for (const fs of form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-kind]')) {
      const on = fs.dataset.kind === k;
      fs.hidden = !on;
      fs.disabled = !on;   // only the chosen kind's fields are read (and required)
    }
  };
  form.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).name === 'kind') showKind(kind());
  });

  // The ROM check (and links) can pick the kind and fill fields: #game&sha1=...&size=...
  const hash = new URLSearchParams(location.hash.slice(1));
  const start = ['game', 'bug', 'feature'].find((k) => hash.has(k)) ?? 'game';
  form.querySelector<HTMLInputElement>(`input[name=kind][value=${start}]`)!.checked = true;
  showKind(start);
  for (const [k, v] of hash) {
    const el = form.querySelector<HTMLInputElement>(`fieldset[data-kind=${start}] [name="${CSS.escape(k)}"]`);
    if (el && v) el.value = v;
  }

  const showErrors = (errors: Record<string, string>) => {
    for (const el of form.querySelectorAll<HTMLElement>('[data-error]')) {
      const fieldset = el.closest('fieldset');
      const msg = fieldset && fieldset.hidden ? '' : errors[el.dataset.error!] ?? '';
      el.textContent = msg;
      el.closest('.field')?.classList.toggle('bad', !!msg);
    }
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const raw = Object.fromEntries(new FormData(form)) as Record<string, string>;
    // A bot filled the hidden field: thank it and send nothing.
    if (raw.website) { form.hidden = true; thanks.hidden = false; return; }
    const sub = clean(kind(), raw)!;
    const errors = validate(sub);
    showErrors(errors);
    if (Object.keys(errors).length) {
      status.textContent = 'Some fields need a look.';
      status.className = 'status small error';
      form.querySelector<HTMLElement>('.field.bad input, .field.bad textarea, .field.bad select')?.focus();
      return;
    }
    send.disabled = true;
    status.textContent = 'SENDING…';
    status.className = 'status small';
    try {
      const res = await fetch(ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(toFirestore(sub)) });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      form.querySelector<HTMLInputElement>(`input[name=kind][value=${sub.kind}]`)!.checked = true;
      form.hidden = true;
      thanks.hidden = false;
      thanks.scrollIntoView({ behavior: 'smooth', block: 'center' });
      status.textContent = '';
    } catch {
      status.textContent = 'It didn\'t go through - check the connection and try again.';
      status.className = 'status small error';
    } finally {
      send.disabled = false;
    }
  });

  thanks.querySelector('[data-again]')!.addEventListener('click', () => {
    thanks.hidden = true;
    form.hidden = false;
    showKind(kind());
  });
</script>
